<UserControl
    x:Class="ImageViewer.Controls.Volume3DViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf/SharpDX"
    xmlns:localization="clr-namespace:ImageViewer.Localization">
    <Grid Background="#0A0F16">
        <Grid.ContextMenu>
            <ContextMenu x:Name="threeDContextMenu" x:FieldModifier="internal">
                <MenuItem Header="{localization:UiText Menu3DResetCamera}" ToolTip="{localization:UiText Menu3DResetCameraTooltip}" Click="OnResetCameraClick" />
                <MenuItem Header="{localization:UiText Menu3DFitVolume}" ToolTip="{localization:UiText Menu3DFitVolumeTooltip}" Click="OnFitVolumeClick" />
                <MenuItem Header="{localization:UiText Menu3DFrontView}" ToolTip="{localization:UiText Menu3DFrontViewTooltip}" Click="OnFrontViewClick" />
                <MenuItem Header="{localization:UiText Menu3DBackView}" ToolTip="{localization:UiText Menu3DBackViewTooltip}" Click="OnBackViewClick" />
                <MenuItem Header="{localization:UiText Menu3DTopView}" ToolTip="{localization:UiText Menu3DTopViewTooltip}" Click="OnTopViewClick" />
                <MenuItem Header="{localization:UiText Menu3DBottomView}" ToolTip="{localization:UiText Menu3DBottomViewTooltip}" Click="OnBottomViewClick" />
                <MenuItem Header="{localization:UiText Menu3DSideView}" ToolTip="{localization:UiText Menu3DSideViewTooltip}" Click="OnSideViewClick" />
                <MenuItem Header="{localization:UiText Menu3DOppositeSideView}" ToolTip="{localization:UiText Menu3DOppositeSideViewTooltip}" Click="OnOppositeSideViewClick" />
                <MenuItem Header="{localization:UiText Menu3DIsometricView}" ToolTip="{localization:UiText Menu3DIsometricViewTooltip}" Click="OnIsometricViewClick" />
                <MenuItem Header="{localization:UiText Menu3DShowCoordinateSystem}" ToolTip="{localization:UiText Menu3DShowCoordinateSystemTooltip}" IsCheckable="True" IsChecked="True" Click="OnCoordinateSystemClick" />
                <MenuItem Header="{localization:UiText Menu3DShowBoundingBox}" ToolTip="{localization:UiText Menu3DShowBoundingBoxTooltip}" IsCheckable="True" IsChecked="True" Click="OnBoundingBoxClick" />
                <MenuItem Header="{localization:UiText Menu3DShowAxialPlane}" ToolTip="{localization:UiText Menu3DShowAxialPlaneTooltip}" IsCheckable="True" IsChecked="True" Click="OnAxialPlaneClick" />
                <MenuItem Header="{localization:UiText Menu3DShowCoronalPlane}" ToolTip="{localization:UiText Menu3DShowCoronalPlaneTooltip}" IsCheckable="True" Click="OnCoronalPlaneClick" />
                <MenuItem Header="{localization:UiText Menu3DShowSagittalPlane}" ToolTip="{localization:UiText Menu3DShowSagittalPlaneTooltip}" IsCheckable="True" Click="OnSagittalPlaneClick" />
                <MenuItem Header="{localization:UiText Menu3DIncreaseTransparency}" ToolTip="{localization:UiText Menu3DIncreaseTransparencyTooltip}" Click="OnIncreaseTransparencyClick" />
                <MenuItem Header="{localization:UiText Menu3DDecreaseTransparency}" ToolTip="{localization:UiText Menu3DDecreaseTransparencyTooltip}" Click="OnDecreaseTransparencyClick" />
                <Separator />
                <MenuItem Header="{localization:UiText Menu3DSwitchToAxialSlice}" ToolTip="{localization:UiText Menu3DSwitchToAxialSliceTooltip}" Click="OnSwitchToAxialSliceClick" />
            </ContextMenu>
        </Grid.ContextMenu>
        <helix:Viewport3DX
            x:Name="viewport"
            BackgroundColor="#11151C"
            CameraRotationMode="Trackball"
            ShowCoordinateSystem="True"
            ShowFrameRate="False"
            IsShadowMappingEnabled="False" />
        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="12"
            Padding="8,5"
            Background="#C018212E"
            CornerRadius="8">
            <TextBlock x:Name="volumeStatusText" Foreground="#F5F8FC" />
        </Border>
    </Grid>
</UserControl>
