<UserControl
    x:Class="ImageViewer.Controls.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImageViewer.Controls"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    AllowDrop="True"
    UseLayoutRounding="True"
    automation:AutomationProperties.Name="{localization:UiText ViewerAccessibleName}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <LinearGradientBrush x:Key="ViewerBackdropBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E141D" Offset="0" />
            <GradientStop Color="#0A0F16" Offset="0.55" />
            <GradientStop Color="#080B11" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#18212E" />
        <SolidColorBrush x:Key="ViewerSurfaceAltBrush" Color="#111824" />
        <SolidColorBrush x:Key="ViewerPanelBorderBrush" Color="#314158" />
        <SolidColorBrush x:Key="ViewerAccentBrush" Color="#69AFFF" />
        <SolidColorBrush x:Key="ViewerAccentSoftBrush" Color="#2869AFFF" />
        <SolidColorBrush x:Key="ViewerAccentBorderBrush" Color="#567FD6FF" />
        <SolidColorBrush x:Key="ViewerTextPrimaryBrush" Color="#F5F8FC" />
        <SolidColorBrush x:Key="ViewerTextSecondaryBrush" Color="#AAB5C3" />
        <SolidColorBrush x:Key="ViewerButtonHoverBrush" Color="#243245" />
        <SolidColorBrush x:Key="ViewerButtonPressedBrush" Color="#2D3D54" />
        <SolidColorBrush x:Key="ViewerChipBorderBrush" Color="#35506D" />
        <SolidColorBrush x:Key="ViewerErrorBrush" Color="#FF6B6B" />
        <SolidColorBrush x:Key="ViewerErrorSoftBrush" Color="#3D1F2A" />
        <SolidColorBrush x:Key="ViewerErrorBorderBrush" Color="#B94A5A" />

        <ControlTemplate x:Key="ViewerChromeButtonTemplate" TargetType="{x:Type ButtonBase}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ViewerButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ViewerButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ViewerFloatingPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <effects:DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.28" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
        </Style>

        <Style x:Key="ViewerToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBorderBrush}" />
        </Style>

        <Style x:Key="ViewerErrorPanelStyle" TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerErrorSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerErrorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="ViewerErrorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerErrorSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerErrorBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ViewerTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ViewerErrorDismissButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ViewerErrorBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerErrorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
        </Style>

        <Style x:Key="ViewerToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewerProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="Background" Value="#172433" />
            <Setter Property="BorderBrush" Value="#28405B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="rootGrid" Background="{StaticResource ViewerBackdropBrush}" ClipToBounds="True" SnapsToDevicePixels="True" AllowDrop="True">
        <Grid.ContextMenu>
            <ContextMenu x:Name="mainContextMenu" x:FieldModifier="internal" Opened="OnContextMenuOpened">
                <ContextMenu.Resources>
                    <Style TargetType="ContextMenu">
                        <Setter Property="Background" Value="#18212E" />
                        <Setter Property="Foreground" Value="#F5F8FC" />
                        <Setter Property="BorderBrush" Value="#314158" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="#18212E" BorderBrush="#314158" BorderThickness="1" CornerRadius="6" Padding="2" SnapsToDevicePixels="True">
                                        <DockPanel LastChildFill="True">
                                            <!-- 搜索区固定挂在菜单模板顶部，而不是作为一个菜单项：
                                                 作为菜单项时会被自动生成的容器按内容宽度左对齐（HorizontalContentAlignment=Left），
                                                 导致搜索框塌成一个小方块、无法横贯菜单宽度。 -->
                                            <StackPanel DockPanel.Dock="Top">
                                                <TextBox x:Name="PART_MenuSearchBox"
                                                         Margin="4"
                                                         Padding="8,5"
                                                         HorizontalAlignment="Stretch"
                                                         Background="#111824"
                                                         Foreground="#F5F8FC"
                                                         BorderBrush="#314158"
                                                         CaretBrush="#F5F8FC"
                                                         SelectionBrush="#69AFFF"
                                                         ToolTip="{localization:UiText MenuSearch}"
                                                         TextChanged="OnMenuSearchTextChanged"
                                                         PreviewKeyDown="OnMenuSearchPreviewKeyDown" />
                                                <TextBlock x:Name="PART_MenuSearchMatchCount"
                                                           Margin="12,4,12,2"
                                                           Foreground="{StaticResource ViewerAccentBrush}"
                                                           Text="{localization:UiText MenuSearchMatchCount}"
                                                           Visibility="Collapsed" />
                                                <TextBlock x:Name="PART_MenuSearchNoResults"
                                                           Margin="12,4,12,8"
                                                           Foreground="{StaticResource ViewerTextSecondaryBrush}"
                                                           Text="{localization:UiText MenuSearchNoResults}"
                                                           Visibility="Collapsed" />
                                                <Separator />
                                            </StackPanel>
                                            <ItemsPresenter SnapsToDevicePixels="True" />
                                        </DockPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="#F5F8FC" />
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid>
                                        <Border x:Name="menuItemBorder" Background="Transparent" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" x:Name="checkGlyph" Visibility="Collapsed"
                                                      Data="M 0,4 L 3.5,7.5 L 8,1" Stroke="#69AFFF" StrokeThickness="1.5"
                                                      Margin="10,0,4,0" VerticalAlignment="Center" Width="8" Height="9" />
                                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  RecognizesAccessKey="True" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" x:Name="shortcutText"
                                                           Text="{TemplateBinding InputGestureText}"
                                                           Foreground="#AAB5C3" Margin="24,0,10,0"
                                                           VerticalAlignment="Center" FontSize="11" />
                                                <Path Grid.Column="3" x:Name="submenuArrow" Visibility="Collapsed"
                                                      Data="M 0,0 L 4,4 L 0,8" Stroke="#AAB5C3" StrokeThickness="1.5"
                                                      Margin="0,0,10,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Popup x:Name="SubMenuPopup" AllowsTransparency="True"
                                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                               Placement="Right" VerticalOffset="-2" HorizontalOffset="-2"
                                               PopupAnimation="Slide" Focusable="False">
                                            <Border Background="#18212E" BorderBrush="#314158" BorderThickness="1" CornerRadius="4" Padding="2" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="menuItemBorder" Property="Background" Value="#243245" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="#5A6B7D" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="True">
                                            <Setter TargetName="submenuArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="shortcutText" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Height="1" Background="#314158" Margin="8,3" SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#111824" />
                        <Setter Property="Foreground" Value="#F5F8FC" />
                        <Setter Property="BorderBrush" Value="#314158" />
                        <Setter Property="CaretBrush" Value="#F5F8FC" />
                        <Setter Property="SelectionBrush" Value="#69AFFF" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem Header="{Binding DataContext.ImageLoadStatusText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          IsEnabled="False"
                          Foreground="{StaticResource ViewerErrorBrush}"
                          Visibility="{Binding DataContext.ImageLoadHasError, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <MenuItem Header="{localization:UiText ImageLoadRetry}"
                          Click="OnRetryImageLoadClick"
                          Visibility="{Binding DataContext.CanRetryImageLoad, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Separator Visibility="{Binding DataContext.ImageLoadHasError, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <MenuItem x:Name="drawRoiMenuItem" x:FieldModifier="internal" Header="{localization:UiText MenuDraw}" ToolTip="{localization:UiText MenuDrawTooltip}" IsEnabled="{Binding MenuState.Context.DrawRoiEnabled}" />
                <MenuItem x:Name="measureMenuItem" Header="{localization:UiText MenuMeasure}">
                    <MenuItem x:Name="gradientDetectMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.GradientDetect}" Header="{localization:UiText MenuGradientAlignCaliper}" IsEnabled="{Binding MenuState.Context.GradientDetectEnabled}" />
                </MenuItem>
                <MenuItem x:Name="roiOperationsMenuItem" Header="{localization:UiText MenuRoiOperations}">
                    <MenuItem x:Name="undoMenuItem" x:FieldModifier="internal" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Undo}" Header="{localization:UiText MenuUndo}" InputGestureText="Ctrl+Z" IsEnabled="{Binding MenuState.Context.UndoEnabled}" />
                    <MenuItem x:Name="redoMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Redo}" Header="{localization:UiText MenuRedo}" InputGestureText="Ctrl+Y" IsEnabled="{Binding MenuState.Context.RedoEnabled}" />
                    <Separator />
                    <MenuItem x:Name="deleteRoiMenuItem" x:FieldModifier="internal" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.DeleteSelected}" Header="{localization:UiText MenuDeleteSelectedRoi}" ToolTip="{localization:UiText RoiDestructiveActionUndoHint}" IsEnabled="{Binding MenuState.Context.DeleteSelectedEnabled}" />
                    <MenuItem x:Name="clearAllMenuItem" x:FieldModifier="internal" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.ClearAll}" Header="{localization:UiText MenuClearAllRois}" ToolTip="{localization:UiText RoiClearAllUndoHint}" IsEnabled="{Binding MenuState.Context.ClearAllEnabled}" />
                    <Separator />
                    <MenuItem x:Name="editPropertiesMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.EditProperties}" Header="{localization:UiText MenuEditProperties}" IsEnabled="{Binding MenuState.Context.EditPropertiesEnabled}" />
                    <MenuItem x:Name="setLabelMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetLabel}" Header="{localization:UiText MenuSetLabel}" IsEnabled="{Binding MenuState.Context.SetLabelEnabled}" />
                    <MenuItem x:Name="setColorMenuItem" Header="{localization:UiText MenuSetColor}" IsEnabled="{Binding MenuState.Context.SetColorEnabled}">
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorCyanDefault}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorCyan}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorRed}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorRed}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorGreen}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorGreen}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorYellow}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorYellow}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorMagenta}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorMagenta}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="calibratePixelsMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.CalibratePixels}" Header="{localization:UiText MenuCalibratePixels}" IsEnabled="{Binding MenuState.Context.CalibratePixelsEnabled}" />
                    <MenuItem x:Name="editCaliperSettingsMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.EditCaliperSettings}" Header="{localization:UiText MenuEditCaliperSettings}" IsEnabled="{Binding MenuState.Context.EditCaliperSettingsEnabled}" />
                    <Separator />
                    <MenuItem x:Name="showRoiListMenuItem" Header="{localization:UiText MenuShowRoiList}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleRoiList}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowRoiListChecked}" />
                    <MenuItem x:Name="zoomToSelectionMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ZoomToSelection}" Header="{localization:UiText MenuZoomToSelectedRoi}" IsEnabled="{Binding MenuState.View.ZoomToSelectionEnabled}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuFileAndProjects}">
                    <MenuItem x:Name="openImageMenuItem" x:FieldModifier="internal" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}" Header="{localization:UiText MenuOpenImageFile}" InputGestureText="Ctrl+O" />
                    <Separator />
                    <MenuItem x:Name="saveSessionMenuItem" x:FieldModifier="internal" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.SaveSession}" Header="{localization:UiText MenuSaveSession}" InputGestureText="Ctrl+S" IsEnabled="{Binding MenuState.File.SaveSessionEnabled}" />
                    <MenuItem x:Name="loadSessionMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.LoadSession}" Header="{localization:UiText MenuOpenProjectOrSession}" />
                    <MenuItem x:Name="recentProjectsMenuItem" Header="{localization:UiText MenuRecentProjects}" ItemsSource="{Binding MenuState.File.RecentProjects}" IsEnabled="{Binding MenuState.File.RecentProjectsEnabled}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                <Setter Property="Tag" Value="{Binding Tag}" />
                                <EventSetter Event="Click" Handler="OnFileMenuCommandClick" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="saveRoisMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.SaveRois}" Header="{localization:UiText MenuSaveRois}" IsEnabled="{Binding MenuState.File.SaveRoisEnabled}" />
                    <MenuItem x:Name="loadRoisMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.LoadRois}" Header="{localization:UiText MenuLoadRois}" />
                    <Separator />
                    <MenuItem x:Name="exportProjectPackageMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.ExportProjectPackage}" Header="{localization:UiText MenuExportProjectPackage}" IsEnabled="{Binding MenuState.File.ExportProjectPackageEnabled}" />
                    <MenuItem x:Name="autoSaveMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.ToggleAutoSave}" Header="{localization:UiText MenuAutoSave}" IsCheckable="True" IsChecked="{Binding MenuState.File.AutoSaveChecked}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuViewControl}">
                    <MenuItem x:Name="fitToViewMenuItem" x:FieldModifier="internal" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}" Header="{localization:UiText MenuFitToView}" InputGestureText="Ctrl+F" IsEnabled="{Binding MenuState.View.FitToViewEnabled}" />
                    <MenuItem Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FillToView}" Header="{localization:UiText MenuFillToView}" IsEnabled="{Binding MenuState.View.FitToViewEnabled}" />
                    <MenuItem x:Name="actualSizeMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ActualSize}" Header="{localization:UiText MenuActualSize}" IsEnabled="{Binding MenuState.View.ActualSizeEnabled}" />
                    <MenuItem x:Name="resetViewMenuItem" x:FieldModifier="internal" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ResetView}" Header="{localization:UiText MenuResetView}" InputGestureText="Ctrl+0" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                    <Separator />
                    <MenuItem Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.RotateLeft}" Header="{localization:UiText MenuRotateLeft}" InputGestureText="Ctrl+Shift+R" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                    <MenuItem Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.RotateRight}" Header="{localization:UiText MenuRotateRight}" InputGestureText="Ctrl+R" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                    <MenuItem Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FlipHorizontal}" Header="{localization:UiText MenuFlipHorizontal}" InputGestureText="Ctrl+H" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                    <MenuItem Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FlipVertical}" Header="{localization:UiText MenuFlipVertical}" InputGestureText="Ctrl+Shift+H" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuDisplaySettings}">
                    <MenuItem x:Name="showToolbarMenuItem" x:FieldModifier="internal" Header="{localization:UiText MenuShowToolbar}" ToolTip="{localization:UiText MenuShowToolbarTooltip}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleToolbar}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowToolbarChecked}" />
                    <MenuItem x:Name="showPixelGridMenuItem" Header="{localization:UiText MenuShowPixelGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.TogglePixelGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowPixelGridChecked}" />
                    <MenuItem x:Name="showSnapGridMenuItem" Header="{localization:UiText MenuShowSnapGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleSnapGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowSnapGridChecked}" />
                    <MenuItem x:Name="enableSnapToGridMenuItem" Header="{localization:UiText MenuEnableSnapToGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleSnapToGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.EnableSnapToGridChecked}" />
                    <Separator />
                    <MenuItem x:Name="showCrosshairMenuItem" Header="{localization:UiText MenuShowCrosshair}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleCrosshair}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowCrosshairChecked}" />
                    <MenuItem x:Name="showCaliperScoresMenuItem" Header="{localization:UiText MenuShowCaliperScores}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleCaliperScores}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowCaliperScoresChecked}" />
                    <Separator />
                    <MenuItem x:Name="showInfoPanelMenuItem" x:FieldModifier="internal" Header="{localization:UiText MenuShowInfoPanel}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleInfoPanel}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowInfoPanelChecked}" />
                    <MenuItem x:Name="showHistogramMenuItem" Header="{localization:UiText MenuShowHistogram}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleHistogram}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowHistogramChecked}" />
                    <MenuItem x:Name="showProfileMenuItem" Header="{localization:UiText MenuShowProfile}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleProfile}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowProfileChecked}" />
                    <MenuItem x:Name="showScaleBarMenuItem" Header="{localization:UiText MenuShowScaleBar}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleScaleBar}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowScaleBarChecked}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuAnalysisAndExport}">
                    <MenuItem x:Name="exportSnapshotMenuItem" x:FieldModifier="internal" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportSnapshot}" Header="{localization:UiText MenuExportCurrentViewPng}" IsEnabled="{Binding MenuState.Context.ExportSnapshotEnabled}" />
                    <MenuItem x:Name="exportAnalysisCsvMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportAnalysisCsv}" Header="{localization:UiText MenuExportAnalysisCsv}" IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled}" />
                    <MenuItem x:Name="exportBatchAnalysisCsvMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportBatchAnalysisCsv}" Header="{localization:UiText MenuExportBatchAnalysisCsv}" IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled}" />
                    <MenuItem x:Name="showAnalysisSummaryMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ShowAnalysisSummary}" Header="{localization:UiText MenuShowAnalysisSummary}" IsEnabled="{Binding MenuState.Context.ShowAnalysisSummaryEnabled}" />
                    <Separator />
                    <MenuItem Header="{localization:UiText MenuAnalysisRun}">
                        <MenuItem x:Name="enableAsyncAnalysisMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAsyncAnalysis}" Header="{localization:UiText MenuEnableAsyncAnalysis}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableAsyncAnalysisChecked}" />
                        <MenuItem x:Name="pauseRealtimeHistogramMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePauseRealtimeHistogram}" Header="{localization:UiText MenuPauseRealtimeHistogram}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PauseRealtimeHistogramChecked}" IsEnabled="{Binding MenuState.Analysis.PauseRealtimeHistogramEnabled}" />
                        <MenuItem x:Name="pauseRealtimeProfileMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePauseRealtimeProfile}" Header="{localization:UiText MenuPauseRealtimeProfile}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PauseRealtimeProfileChecked}" IsEnabled="{Binding MenuState.Analysis.PauseRealtimeProfileEnabled}" />
                        <MenuItem x:Name="refreshAnalysisMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.RefreshAnalysis}" Header="{localization:UiText MenuRefreshAnalysis}" IsEnabled="{Binding MenuState.Analysis.EnableRefreshAnalysis}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuLargeImageAndPerformance}">
                    <MenuItem x:Name="smartDisplaySuggestionMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ShowSmartDisplaySuggestion}" Header="{localization:UiText MenuSmartDisplaySuggestion}" IsEnabled="{Binding MenuState.Analysis.EnableRefreshAnalysis}" />
                    <Separator />
                    <MenuItem x:Name="enableImagePyramidMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleImagePyramid}" Header="{localization:UiText MenuEnableImagePyramid}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableImagePyramidChecked}" />
                    <MenuItem x:Name="autoSelectPyramidLevelMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAutoSelectPyramidLevel}" Header="{localization:UiText MenuAutoSelectPyramidLevel}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.AutoSelectPyramidLevelChecked}" IsEnabled="{Binding MenuState.Analysis.AutoSelectPyramidLevelEnabled}" />
                    <MenuItem Header="{localization:UiText MenuAdvancedPerformance}">
                        <MenuItem x:Name="enableTiledRenderingMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleTiledRendering}" Header="{localization:UiText MenuEnableTiledRendering}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableTiledRenderingChecked}" />
                        <MenuItem x:Name="prefetchAdjacentTilesMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePrefetchAdjacentTiles}" Header="{localization:UiText MenuPrefetchAdjacentTiles}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PrefetchAdjacentTilesChecked}" IsEnabled="{Binding MenuState.Analysis.PrefetchAdjacentTilesEnabled}" />
                        <MenuItem x:Name="gpuRenderingMenuItem" Header="{localization:UiText MenuEnableGpuViewportCache}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleGpuRendering}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.GpuRenderingChecked}" />
                        <Separator />
                        <MenuItem x:Name="clearPyramidCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearPyramidCache}" Header="{localization:UiText MenuClearPyramidCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearPyramidCache}" />
                        <MenuItem x:Name="clearAnalysisCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearAnalysisCache}" Header="{localization:UiText MenuClearAnalysisCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearAnalysisCache}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{localization:UiText MenuPseudoColorStrategy}">
                        <MenuItem x:Name="preferShaderPseudoColorMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePreferShaderPseudoColor}" Header="{localization:UiText MenuPreferShaderPseudoColor}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PreferShaderPseudoColorChecked}" />
                        <MenuItem x:Name="allowCpuPseudoColorFallbackMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAllowCpuPseudoColorFallback}" Header="{localization:UiText MenuAllowCpuFallback}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.AllowCpuPseudoColorFallbackChecked}" />
                    </MenuItem>
                    <MenuItem x:Name="pseudoColorMenuItem" x:FieldModifier="internal" Header="{localization:UiText MenuPseudoColor}">
                        <MenuItem Header="{localization:UiText MenuPseudoColorOriginal}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteNone}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorNoneChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorHot}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteHot}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorHotChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorJet}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteJet}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorJetChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorViridis}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteViridis}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorViridisChecked}" />
                    </MenuItem>
                    <MenuItem x:Name="showRenderStatusMenuItem" x:FieldModifier="internal" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ShowRenderStatus}" Header="{localization:UiText MenuShowRenderStatus}" IsEnabled="{Binding MenuState.Analysis.EnableShowRenderStatus}" />
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Canvas x:Name="canvas" SnapsToDevicePixels="True">
            <!-- 图像容器，负责缩放和平移 -->
            <Canvas x:Name="imageContainer" x:FieldModifier="internal" SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform" />
                        <ScaleTransform x:Name="orientationScaleTransform" />
                        <RotateTransform x:Name="orientationRotateTransform" />
                        <TranslateTransform x:Name="translateTransform" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- 图像显示 -->
                <Image x:Name="image" x:FieldModifier="internal"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       automation:AutomationProperties.Name="{localization:UiText ImageDisplayAreaName}"
                       automation:AutomationProperties.HelpText="{localization:UiText ImageDisplayAreaHelpText}" />

                <Canvas x:Name="snapGridCanvas" IsHitTestVisible="False" Opacity="0.6" />

                <!-- ROI 覆盖层 -->
                <Canvas x:Name="overlayCanvas" SnapsToDevicePixels="True">
                    <Canvas x:Name="committedOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="selectionOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="activeOverlayCanvas" SnapsToDevicePixels="True" />
                </Canvas>
                
                <!-- 像素网格层 -->
                <Canvas x:Name="pixelGridCanvas" IsHitTestVisible="False" Opacity="0.5" />
            </Canvas>
        </Canvas>

        <Canvas x:Name="screenOverlayCanvas" IsHitTestVisible="False" SnapsToDevicePixels="True">
            <!-- 缩放比例徽标：跟随光标短暂显示，淡入淡出 -->
            <Border x:Name="zoomBadgeBorder" x:FieldModifier="internal"
                    Padding="10,5"
                    Background="{StaticResource ViewerSurfaceBrush}"
                    BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    Opacity="0">
                <Border.Effect>
                    <effects:DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <TextBlock x:Name="zoomBadgeTextBlock" x:FieldModifier="internal"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <Border x:Name="diagnosticErrorBorder"
            x:FieldModifier="internal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            Padding="12,9,8,9"
            Style="{StaticResource ViewerErrorPanelStyle}"
            Panel.ZIndex="120"
            Visibility="{Binding HasDiagnosticError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="True">
                <Button x:Name="diagnosticErrorDismissButton" x:FieldModifier="internal"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    Content="×"
                        ToolTip="{localization:UiText MenuDismissError}"
                    automation:AutomationProperties.Name="{localization:UiText MenuDismissError}"
                    Click="OnDismissDiagnosticErrorClick"
                    Style="{StaticResource ViewerErrorDismissButtonStyle}" />
                <TextBlock x:Name="diagnosticErrorIconTextBlock" x:FieldModifier="internal"
                    DockPanel.Dock="Left"
                    Text="⚠"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource ViewerErrorBrush}"
                    FontSize="15"
                    FontWeight="Bold" />
                 <TextBlock x:Name="diagnosticErrorTextBlock" x:FieldModifier="internal"
                     Text="{Binding DiagnosticErrorText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{StaticResource ViewerTextPrimaryBrush}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   MaxWidth="360"
                   automation:AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <!-- 十字准星（不随图像缩放） -->
        <Canvas IsHitTestVisible="False">
            <Line x:Name="crosshairH" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
            <Line x:Name="crosshairV" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
        </Canvas>

        <!-- 坐标显示 -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Padding="10,6"
                Background="#C0141D29"
                BorderBrush="#334A63"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=coordTextBlock}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="coordTextBlock"
                       Foreground="{StaticResource ViewerTextPrimaryBrush}"
                       FontWeight="SemiBold" />
        </Border>

        <!-- 比例尺 -->
        <Canvas x:Name="scaleBarCanvas" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="10,0,0,35" 
                Width="150" 
                Height="30" 
                IsHitTestVisible="False" 
                Visibility="Collapsed">
            <Polyline x:Name="scaleBarLine" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Points="0,0 0,10 100,10 100,0" />
            <TextBlock x:Name="scaleBarText" Text="{localization:UiText ScaleBarDefault}" Foreground="{StaticResource ViewerTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Canvas.Left="30" Canvas.Top="-5"/>
        </Canvas>

        <!-- 常驻状态栏：图像尺寸与文件路径（底部居中常驻显示） -->
        <Border x:Name="statusBarBorder" x:FieldModifier="internal"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="10,0,10,10"
                MaxWidth="620"
                Padding="10,6"
                Background="#C0141D29"
                BorderBrush="#334A63"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Panel.ZIndex="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="statusBarTextBlock" x:FieldModifier="internal"
                           Grid.Column="0"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           automation:AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Text="{localization:UiText StatusUnsavedMarker}"
                           Foreground="{StaticResource ViewerAccentBrush}"
                           FontWeight="Bold"
                           Visibility="{Binding IsDirty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                           automation:AutomationProperties.Name="{localization:UiText StatusUnsavedAccessibleName}" />
                <Border x:Name="calibrationBadge"
                        x:FieldModifier="internal"
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="8,3"
                        Background="{StaticResource ViewerAccentSoftBrush}"
                        BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        automation:AutomationProperties.Name="{localization:UiText CalibrationBadgeAccessibleName}"
                        automation:AutomationProperties.LiveSetting="Polite">
                    <TextBlock x:Name="calibrationBadgeTextBlock"
                               x:FieldModifier="internal"
                               MaxWidth="300"
                               Foreground="{StaticResource ViewerTextPrimaryBrush}"
                               FontWeight="Bold"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="recoveryBanner"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="10"
                Padding="10,7"
                Background="{StaticResource ViewerSurfaceBrush}"
                BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="125"
                Visibility="{Binding HasRecoverySnapshot, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           Text="{localization:UiText RecoveryBannerText}"
                           automation:AutomationProperties.LiveSetting="Polite" />
                <Button Padding="10,4"
                        Content="{localization:UiText RecoveryRestoreButton}"
                        Click="OnRecoverAutoSaveClick"
                        Background="{StaticResource ViewerAccentSoftBrush}"
                        BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                        Foreground="{StaticResource ViewerTextPrimaryBrush}" />
                <Button Margin="6,0,0,0"
                        Padding="8,4"
                        Content="{localization:UiText RecoveryDismissButton}"
                        Click="OnDismissRecoveryClick"
                        Background="Transparent"
                        BorderBrush="{StaticResource ViewerPanelBorderBrush}"
                        Foreground="{StaticResource ViewerTextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- 右侧信息区按垂直顺序排列，避免结果、ROI 列表和属性编辑器相互覆盖。 -->
        <StackPanel x:Name="rightOverlayPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
                    Width="340"
                    Panel.ZIndex="95">
            <!-- 信息面板 -->
            <Border x:Name="infoPanel"
                    x:FieldModifier="internal"
                    Margin="0,0,0,8"
                    Padding="5"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ViewerFloatingPanelStyle}"
                    IsHitTestVisible="False"
                    Visibility="Visible">
                <TextBlock x:Name="infoTextBlock" Foreground="{StaticResource ViewerTextPrimaryBrush}" TextWrapping="Wrap" MaxWidth="320" />
            </Border>

            <Border x:Name="roiListPanel"
                    x:FieldModifier="internal"
                    Margin="0,0,0,8"
                    Padding="6"
                    HorizontalAlignment="Right"
                    Width="240"
                    MaxHeight="320"
                    Style="{StaticResource ViewerFloatingPanelStyle}"
                    Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{localization:UiText RoiListTitle}"
                                   Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="roiListCountText"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource ViewerTextSecondaryBrush}"
                                   Text="{Binding ViewerState.AllRois.Count, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}({0})}" />
                    </DockPanel>
                    <TextBox x:Name="roiFilterTextBox"
                             Grid.Row="1"
                             Margin="0,0,0,6"
                             Padding="7,4"
                             TextChanged="OnRoiFilterTextChanged"
                             ToolTip="{localization:UiText RoiListFilterTooltip}"
                             automation:AutomationProperties.Name="{localization:UiText RoiListFilterAccessibleName}" />
                    <ListBox Grid.Row="2"
                             x:Name="roiListBox" x:FieldModifier="internal"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource ViewerTextPrimaryBrush}"
                             automation:AutomationProperties.Name="{localization:UiText RoiListAccessibleName}"
                             ItemsSource="{Binding ViewerState.AllRois, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             SelectedItem="{Binding ViewerState.SelectedRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{StaticResource ViewerTextSecondaryBrush}"
                                                   FontSize="10"
                                                   Text="{Binding DisplayTypeName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              ToolTip="{localization:UiText RoiListToggleVisibleTooltip}"
                                              Content="{localization:UiText RoiListToggleVisible}" />
                                    <CheckBox Grid.Column="2"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                              IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                              ToolTip="{localization:UiText RoiListToggleLockedTooltip}"
                                              Content="{localization:UiText RoiListToggleLocked}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Padding="8,3"
                                Margin="0,0,6,0"
                                Content="{localization:UiText RoiListZoomButton}"
                                Click="OnRoiListZoomClick"
                                IsEnabled="{Binding MenuState.View.ZoomToSelectionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{localization:UiText RoiListZoomTooltip}" />
                        <Button Padding="8,3"
                                Content="{localization:UiText RoiListDeleteButton}"
                                Click="OnRoiListDeleteClick"
                                IsEnabled="{Binding MenuState.Context.DeleteSelectedEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ToolTip="{localization:UiText RoiListDeleteTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="roiPropertyPanel"
                    Margin="0"
                    Padding="6"
                    HorizontalAlignment="Right"
                    Width="320"
                    MaxHeight="420"
                    Style="{StaticResource ViewerFloatingPanelStyle}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{localization:UiText PropertyPanelTitle}"
                                   Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="circularCaliperSettingsButton"
                                x:FieldModifier="internal"
                                Grid.Column="1"
                                Padding="8,3"
                                Margin="8,0,0,0"
                                Content="{localization:UiText QuickCircularCaliperSettings}"
                                ToolTip="{localization:UiText QuickCircularCaliperSettingsTooltip}"
                                Click="OnQuickCircularCaliperSettingsClick"
                                Style="{StaticResource ViewerToolbarPrimaryButtonStyle}"
                                Visibility="Collapsed"
                                automation:AutomationProperties.Name="{localization:UiText QuickCircularCaliperSettings}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="roiPropertyEditorHost" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>

        <Button x:Name="rightOverlayToggleButton"
                x:FieldModifier="internal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Padding="7,4"
                Panel.ZIndex="96"
                Content="◀"
                Click="OnRightOverlayToggleClick"
                ToolTip="{localization:UiText FloatingPanelsToggleTooltip}"
                automation:AutomationProperties.Name="{localization:UiText FloatingPanelsToggleAccessibleName}"
                Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />

        <!-- 直方图面板 -->
        <Border x:Name="histogramPanel" 
                Margin="10,0,10,40" 
                Padding="5" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266" 
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText HistogramPanelTitle}" Foreground="{StaticResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="histogramCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- 灰度剖面图面板 -->
        <Border x:Name="profilePanel" 
                Margin="10,0,10,40" 
                Padding="5" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266" 
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText ProfilePanelTitle}" Foreground="{StaticResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="profileCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <Border x:Name="emptyStatePanel"
                Width="420"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            Panel.ZIndex="90">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}" />
                                <Condition Binding="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="360">
                <Border Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Background="{StaticResource ViewerAccentSoftBrush}"
                        BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Viewbox Margin="16">
                        <Canvas Width="40" Height="40">
                            <Path Data="M4,8 H36 V32 H4 Z" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" />
                            <Path Data="M8,26 L16,18 L24,26 L29,21 L34,28" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="28" Canvas.Top="12" Width="4" Height="4" Fill="{StaticResource ViewerAccentBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="{localization:UiText EmptyStateTitle}"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />

                <TextBlock Text="{localization:UiText EmptyStateDescription}"
                           Foreground="{StaticResource ViewerTextSecondaryBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateDropLoad}" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateBackgroundRetry}" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="{localization:UiText EmptyStateTiledRendering}" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </WrapPanel>

                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="OnToolbarFileCommandClick"
                        Content="{localization:UiText MenuOpenImageFile}"
                        Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                        Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />

                <TextBlock Text="{localization:UiText EmptyStateHint}"
                           Foreground="{StaticResource ViewerTextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="toolbarPanel" x:FieldModifier="internal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                Panel.ZIndex="100"
                Visibility="Collapsed"
                Style="{StaticResource ViewerFloatingPanelStyle}">
            <StackPanel Width="Auto">
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{localization:UiText MenuPrimaryActions}"
                               Style="{StaticResource ViewerSectionTitleStyle}"
                               VerticalAlignment="Center" />
                    <Button x:Name="toolbarHideButton"
                            x:FieldModifier="internal"
                            Grid.Column="1"
                            Content="{localization:UiText ToolbarHideButton}"
                            ToolTip="{localization:UiText ToolbarHideHint}"
                            automation:AutomationProperties.Name="{localization:UiText ToolbarHideButton}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarHideHint}"
                            Click="OnToolbarHideClick"
                            Margin="8,0,0,6"
                            Padding="8,3"
                            FontSize="11"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                </Grid>
                <WrapPanel MaxWidth="460">
                    <Button Content="{localization:UiText MenuOpenImageFile}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                            ToolTip="{localization:UiText ToolbarOpenImageTooltip}"
                            automation:AutomationProperties.Name="{localization:UiText MenuOpenImageFile}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarOpenImageTooltip}"
                            Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />
                    <Button Content="{localization:UiText MenuOpenProjectOrSession}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.LoadSession}"
                            ToolTip="{localization:UiText MenuOpenProjectOrSession}"
                            automation:AutomationProperties.Name="{localization:UiText MenuOpenProjectOrSession}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuOpenProjectOrSession}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuSaveSession}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.SaveSession}"
                            ToolTip="{localization:UiText MenuSaveSession}"
                            automation:AutomationProperties.Name="{localization:UiText MenuSaveSession}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuSaveSession}"
                            IsEnabled="{Binding MenuState.File.SaveSessionEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuUndo}"
                            Click="OnRoiMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerRoiMenuTags.Undo}"
                            ToolTip="Ctrl+Z"
                            automation:AutomationProperties.Name="{localization:UiText MenuUndo}"
                            automation:AutomationProperties.HelpText="Ctrl+Z"
                            IsEnabled="{Binding MenuState.Context.UndoEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuRedo}"
                            Click="OnRoiMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerRoiMenuTags.Redo}"
                            ToolTip="Ctrl+Y"
                            automation:AutomationProperties.Name="{localization:UiText MenuRedo}"
                            automation:AutomationProperties.HelpText="Ctrl+Y"
                            IsEnabled="{Binding MenuState.Context.RedoEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuCalibratePixels}"
                            Click="OnRoiMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerRoiMenuTags.CalibratePixels}"
                            ToolTip="{localization:UiText ToolbarCalibratePixelsTooltip}"
                            automation:AutomationProperties.Name="{localization:UiText MenuCalibratePixels}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarCalibratePixelsTooltip}"
                            IsEnabled="{Binding MenuState.Context.CalibratePixelsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowRoiList}"
                                  IsChecked="{Binding ShowRoiList, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleRoiListTooltip}"
                                  automation:AutomationProperties.Name="{localization:UiText MenuShowRoiList}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleRoiListTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <Button Content="{localization:UiText MenuExportCurrentViewPng}"
                            Click="OnFeatureMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportSnapshot}"
                            ToolTip="{localization:UiText MenuExportCurrentViewPng}"
                            automation:AutomationProperties.Name="{localization:UiText MenuExportCurrentViewPng}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuExportCurrentViewPng}"
                            IsEnabled="{Binding MenuState.Context.ExportSnapshotEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuExportAnalysisCsv}"
                            Click="OnFeatureMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportAnalysisCsv}"
                            ToolTip="{localization:UiText MenuExportAnalysisCsv}"
                            automation:AutomationProperties.Name="{localization:UiText MenuExportAnalysisCsv}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuExportAnalysisCsv}"
                            IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuExportBatchAnalysisCsv}"
                            Click="OnFeatureMenuCommandClick"
                            Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportBatchAnalysisCsv}"
                            ToolTip="{localization:UiText MenuExportBatchAnalysisCsvTooltip}"
                            automation:AutomationProperties.Name="{localization:UiText MenuExportBatchAnalysisCsv}"
                            automation:AutomationProperties.HelpText="{localization:UiText MenuExportBatchAnalysisCsvTooltip}"
                            IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                </WrapPanel>

                <TextBlock Text="{localization:UiText MenuQuickTools}" Style="{StaticResource ViewerSectionTitleStyle}" Margin="0,4,0,8" />
                <WrapPanel x:Name="quickToolsPanel" />

                <TextBlock Text="{localization:UiText MenuViewControl}" Style="{StaticResource ViewerSectionTitleStyle}" Margin="0,4,0,8" />
                <WrapPanel>
                    <Button Content="{localization:UiText MenuZoomOut}"
                        Click="OnToolbarViewCommandClick"
                        Tag="{x:Static controls:ImageViewerViewMenuTags.ZoomOut}"
                        ToolTip="{localization:UiText ToolbarZoomOutTooltip}"
                        automation:AutomationProperties.HelpText="{localization:UiText ToolbarZoomOutTooltip}"
                        Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuZoomIn}"
                        Click="OnToolbarViewCommandClick"
                        Tag="{x:Static controls:ImageViewerViewMenuTags.ZoomIn}"
                        ToolTip="{localization:UiText ToolbarZoomInTooltip}"
                        automation:AutomationProperties.HelpText="{localization:UiText ToolbarZoomInTooltip}"
                        Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Border Margin="0,0,8,8" Padding="10,7" Background="{StaticResource ViewerSurfaceAltBrush}" BorderBrush="{StaticResource ViewerChipBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <TextBlock Text="{Binding Scale, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:P0}}"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.Name="{localization:UiText ZoomLevelDisplayAccessibleName}"
                           ToolTip="{localization:UiText ToolbarZoomLevelTooltip}" />
                    </Border>
                    <Button Content="{localization:UiText MenuFitToView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}"
                            ToolTip="{localization:UiText ToolbarFitToViewTooltip}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarFitToViewTooltip}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuFillToView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.FillToView}"
                            ToolTip="{localization:UiText ToolbarFillToViewTooltip}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarFillToViewTooltip}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuActualSize}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.ActualSize}"
                            ToolTip="{localization:UiText ToolbarActualSizeTooltip}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarActualSizeTooltip}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuResetView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.ResetView}"
                            ToolTip="{localization:UiText ToolbarResetViewTooltip}"
                            automation:AutomationProperties.HelpText="{localization:UiText ToolbarResetViewTooltip}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                </WrapPanel>

                <TextBlock Text="{localization:UiText MenuDisplaySettings}" Style="{StaticResource ViewerSectionTitleStyle}" Margin="0,4,0,8" />
                <WrapPanel>
                    <ToggleButton Content="{localization:UiText MenuShowInfoPanel}"
                                  IsChecked="{Binding ShowInfoPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleInfoPanelTooltip}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleInfoPanelTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowHistogram}"
                                  IsChecked="{Binding ShowHistogram, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleHistogramTooltip}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleHistogramTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowProfile}"
                                  IsChecked="{Binding ShowProfile, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleProfileTooltip}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleProfileTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowScaleBar}"
                                  IsChecked="{Binding ShowScaleBar, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleScaleBarTooltip}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleScaleBarTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowRoiList}"
                                  IsChecked="{Binding ShowRoiList, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  ToolTip="{localization:UiText ToolbarToggleRoiListTooltip}"
                                  automation:AutomationProperties.HelpText="{localization:UiText ToolbarToggleRoiListTooltip}"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Button x:Name="toolbarCompactButton"
                x:FieldModifier="internal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="16"
                MinWidth="40"
                Height="40"
                Padding="10,0"
                Panel.ZIndex="101"
                Content="{localization:UiText ToolbarRestoreButton}"
                ToolTip="{localization:UiText ToolbarRestoreHint}"
                automation:AutomationProperties.Name="{localization:UiText MenuShowToolbar}"
                automation:AutomationProperties.HelpText="{localization:UiText ToolbarRestoreHint}"
                Click="OnCompactToolbarClick"
                Style="{StaticResource ViewerToolbarPrimaryButtonStyle}"
                Visibility="Collapsed" />

        <!-- 当前工具状态（绘制期间持续显示，直到完成或取消） -->
        <Border x:Name="activeToolBanner" x:FieldModifier="internal"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16,0,16,54"
                Padding="12,8"
                Background="{StaticResource ViewerAccentSoftBrush}"
                BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="125"
                Visibility="Collapsed"
                automation:AutomationProperties.LiveSetting="Polite">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="{localization:UiText ActiveToolCancel}"
                        Click="OnActiveToolCancelClick"
                        ToolTip="{localization:UiText ActiveToolCancel}"
                        Margin="12,0,0,0"
                        Padding="12,5"
                        Style="{StaticResource ViewerToolbarButtonStyle}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{localization:UiText ActiveToolPrefix}"
                               Foreground="{StaticResource ViewerTextSecondaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="activeToolNameTextBlock" x:FieldModifier="internal"
                               Foreground="{StaticResource ViewerTextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{localization:UiText ActiveToolHint}"
                               Foreground="{StaticResource ViewerTextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 状态提示横幅（顶部居中，约 3 秒自动消失） -->
        <Border x:Name="statusHintBorder" x:FieldModifier="internal"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="16,14"
                Padding="16,10"
                Background="{StaticResource ViewerSurfaceBrush}"
                BorderBrush="{StaticResource ViewerPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Panel.ZIndex="130"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.Effect>
                <effects:DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="statusHintIconTextBlock" x:FieldModifier="internal"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="Bold"
                           Visibility="Collapsed" />
                <TextBlock x:Name="statusHintTextBlock" x:FieldModifier="internal"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>

        <Border x:Name="imageLoadPanel"
                Margin="16"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"

                Panel.ZIndex="110"
                Width="420"
                Visibility="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Background" Value="{StaticResource ViewerErrorSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource ViewerErrorBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Width="384">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse Stroke="#294055" StrokeThickness="4" />
                    <Ellipse x:Name="loadingSpinner"
                             Stroke="{StaticResource ViewerAccentBrush}"
                             StrokeDashArray="1.2 2.5"
                             StrokeDashCap="Round"
                             StrokeThickness="4">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="loadingSpinnerRotate" CenterX="24" CenterY="24" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="⚠"
                               Foreground="{StaticResource ViewerErrorBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="loadingSpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="imageLoadStatusTextBlock" x:FieldModifier="internal"
                               Text="{Binding ImageLoadStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource ViewerTextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="⚠"
                               Foreground="{StaticResource ViewerErrorBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,6,0,0"
                               Visibility="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ImageLoadProgress, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource ViewerProgressBarStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImageLoadHasError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="14,6"
                            Click="OnRetryImageLoadClick"
                            Content="{localization:UiText ImageLoadRetry}"
                            Visibility="{Binding CanRetryImageLoad, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ViewerErrorActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 拖放视觉反馈：拖入可打开文件时显示，提示松开即可打开 -->
        <Border x:Name="dropHintOverlay" x:FieldModifier="internal"
                Margin="24"
                Background="#66102133"
                BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                BorderThickness="2"
                CornerRadius="16"
                IsHitTestVisible="False"
                Panel.ZIndex="140"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{localization:UiText DropOverlayHint}"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
