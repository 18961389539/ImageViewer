<UserControl
    x:Class="ImageViewer.Controls.AdaptiveImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    automation:AutomationProperties.Name="{localization:UiText AdaptiveViewerName}"
    >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认深色主题。必须放在 UserControl.Resources：放在子级 Grid.Resources 会遮蔽外层，
                     使 Theme/ThemeDictionary 属性切换到别的字典时不生效。 -->
                <ResourceDictionary Source="pack://application:,,,/ImageViewerControl;component/Themes/ViewerTheme.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ViewerBackdropSolidBrush}" Focusable="True" KeyDown="OnKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <!-- 只放本控件私有的样式。主题画刷一律来自 UserControl.Resources 里的统一主题字典，
                     否则子级 Grid.Resources 会遮蔽外层主题，导致 Theme 属性切换后界面不变。 -->
                <Style x:Key="AdaptiveBarButtonStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="{DynamicResource ViewerTextPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ViewerSurfaceAltBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ViewerChipBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ViewerButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ViewerButtonPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="AdaptiveGroupTitleStyle" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ViewerTextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,0,0,5" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="8" Background="{DynamicResource ViewerSurfaceBrush}" BorderBrush="{DynamicResource ViewerPanelBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{localization:UiText AdaptiveViewGroup}" Style="{StaticResource AdaptiveGroupTitleStyle}" />
                <WrapPanel>
                    <Button x:Name="autoButton" Content="{localization:UiText AdaptiveAuto}" Click="OnAutoClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveAutoTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="twoDimensionalButton" Content="{localization:UiText Adaptive2D}" Click="OnTwoDimensionalClick" Margin="0,0,6,0" ToolTip="{localization:UiText Adaptive2DTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="threeDimensionalButton" Content="{localization:UiText Adaptive3D}" Click="OnThreeDimensionalClick" Margin="0,0,6,0" ToolTip="{localization:UiText Adaptive3DTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="axialButton" Content="{localization:UiText AdaptiveAxial}" Click="OnAxialClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveAxialTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="coronalButton" Content="{localization:UiText AdaptiveCoronal}" Click="OnCoronalClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveCoronalTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="sagittalButton" Content="{localization:UiText AdaptiveSagittal}" Click="OnSagittalClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveSagittalTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                </WrapPanel>
                <TextBlock Text="{localization:UiText AdaptiveAnalysisGroup}" Style="{StaticResource AdaptiveGroupTitleStyle}" Margin="0,7,0,5" />
                <WrapPanel>
                    <Button x:Name="qualityButton" Content="{localization:UiText AdaptiveQuality}" Click="OnQualityClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveQualityTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="segmentButton" Content="{localization:UiText AdaptiveSegment}" Click="OnSegmentClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveSegmentTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="cancelButton" Content="{localization:UiText AdaptiveCancel}" Click="OnCancelClick" Style="{StaticResource AdaptiveBarButtonStyle}" ToolTip="{localization:UiText AdaptiveCancelTooltip}" />
                </WrapPanel>
                <TextBlock x:Name="gestureHintText"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource ViewerTextSecondaryBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            <Border x:Name="mprSliceBar"
                    Margin="0,8,0,0"
                    Padding="8,5"
                    Background="{DynamicResource ViewerSurfaceAltBrush}"
                    BorderBrush="{DynamicResource ViewerChipBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="mprSliceStatusText"
                               DockPanel.Dock="Left"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ViewerTextPrimaryBrush}" />
                    <Button x:Name="mprPreviousButton"
                            DockPanel.Dock="Right"
                            Margin="6,0,0,0"
                            Padding="8,3"
                            Content="{localization:UiText AdaptivePreviousSlice}"
                            Click="OnPreviousMprSliceClick"
                            Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Button x:Name="mprNextButton"
                            DockPanel.Dock="Right"
                            Padding="8,3"
                            Content="{localization:UiText AdaptiveNextSlice}"
                            Click="OnNextMprSliceClick"
                            Style="{StaticResource AdaptiveBarButtonStyle}" />
                    <Slider x:Name="mprSliceSlider"
                            Minimum="0"
                            Maximum="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="OnMprSliceValueChanged"
                            AutomationProperties.Name="{localization:UiText AdaptiveMprSliceSliderName}" />
                </DockPanel>
            </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" PreviewMouseWheel="OnPreviewMouseWheel">
            <ContentControl x:Name="contentHost" />
            <Border x:Name="mprRebuildOverlay"
                    Background="{DynamicResource ViewerSurfaceOverlayAltBrush}"
                    Visibility="Collapsed"
                    automation:AutomationProperties.LiveSetting="Polite">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,14"
                        Background="{DynamicResource ViewerSurfaceBrush}"
                        BorderBrush="{DynamicResource ViewerPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{localization:UiText AdaptiveMprRebuilding}"
                                   Foreground="{DynamicResource ViewerTextPrimaryBrush}"
                                   FontSize="13"
                                   TextAlignment="Center" />
                        <ProgressBar Height="5"
                                     Width="190"
                                     Margin="0,9,0,0"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Border>
            </Border>
            <Border x:Name="operationStatusPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ViewerSurfaceOverlayMenuBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerOverlayBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=retryButton}" Value="Visible">
                                <Setter Property="Background" Value="{DynamicResource ViewerErrorSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="⚠" Foreground="{DynamicResource ViewerErrorBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,7,0" Visibility="{Binding Visibility, ElementName=retryButton}" />
                        <TextBlock x:Name="statusText" Foreground="{DynamicResource ViewerTextPrimaryBrush}" automation:AutomationProperties.Name="{localization:UiText AdaptiveViewerStatusName}" automation:AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ProgressBar x:Name="operationProgress" Height="5" Width="180" Margin="0,6,0,0" Visibility="Collapsed" IsIndeterminate="True" />
                </StackPanel>
            </Border>
            <Border x:Name="dataQualityPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8" MaxWidth="360" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ViewerSurfaceOverlayMenuBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ViewerOverlayBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=retryButton}" Value="Visible">
                                <Setter Property="Background" Value="{DynamicResource ViewerErrorSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ViewerErrorBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="⚠" Foreground="{DynamicResource ViewerErrorBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,7,0" Visibility="{Binding Visibility, ElementName=retryButton}" />
                        <TextBlock Text="{localization:UiText AdaptiveDataQualityTitle}" Foreground="{DynamicResource ViewerTextPrimaryBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox x:Name="anomalyList" MaxHeight="100" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ViewerWarningBrush}" SelectionChanged="OnAnomalySelected" />
                    <TextBlock x:Name="segmentationText" Foreground="{DynamicResource ViewerInfoBrush}" TextWrapping="Wrap" />
                    <StackPanel x:Name="segmentationActionsPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <Button x:Name="acceptSegmentationButton" Content="{localization:UiText AdaptiveAccept}" Click="OnAcceptSegmentationClick" Margin="0,0,6,0" Padding="8,3" />
                        <Button x:Name="rejectSegmentationButton" Content="{localization:UiText AdaptiveReject}" Click="OnRejectSegmentationClick" Padding="8,3" />
                    </StackPanel>
                    <StackPanel x:Name="qualityActionsPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <Button x:Name="retryButton" Content="{localization:UiText AdaptiveRetry}" Click="OnRetryQualityClick" Margin="6,0,0,0" Padding="8,3" Visibility="Collapsed" Background="{DynamicResource ViewerErrorSoftBrush}" BorderBrush="{DynamicResource ViewerErrorBorderBrush}" Foreground="{DynamicResource ViewerTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="stateBarText" Padding="8,5" Foreground="{DynamicResource ViewerTextSecondaryBrush}" Background="{DynamicResource ViewerSurfaceAltBrush}" automation:AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
