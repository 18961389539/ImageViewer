<UserControl
    x:Class="ImageViewer.Controls.AdaptiveImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
    automation:AutomationProperties.Name="{localization:UiText AdaptiveViewerName}"
    >
    <Grid Background="#0A0F16" Focusable="True" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="AdaptiveBarButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#F5F8FC" />
                <Setter Property="Background" Value="#111824" />
                <Setter Property="BorderBrush" Value="#35506D" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#243245" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#2D3D54" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="8" Background="#18212E" BorderBrush="#314158" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="autoButton" Content="{localization:UiText AdaptiveAuto}" Click="OnAutoClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveAutoTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="twoDimensionalButton" Content="{localization:UiText Adaptive2D}" Click="OnTwoDimensionalClick" Margin="0,0,6,0" ToolTip="{localization:UiText Adaptive2DTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="threeDimensionalButton" Content="{localization:UiText Adaptive3D}" Click="OnThreeDimensionalClick" Margin="0,0,6,0" ToolTip="{localization:UiText Adaptive3DTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="axialButton" Content="{localization:UiText AdaptiveAxial}" Click="OnAxialClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveAxialTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="coronalButton" Content="{localization:UiText AdaptiveCoronal}" Click="OnCoronalClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveCoronalTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="sagittalButton" Content="{localization:UiText AdaptiveSagittal}" Click="OnSagittalClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveSagittalTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="qualityButton" Content="{localization:UiText AdaptiveQuality}" Click="OnQualityClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveQualityTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="segmentButton" Content="{localization:UiText AdaptiveSegment}" Click="OnSegmentClick" Margin="0,0,6,0" ToolTip="{localization:UiText AdaptiveSegmentTooltip}" Style="{StaticResource AdaptiveBarButtonStyle}" />
                <Button x:Name="cancelButton" Content="{localization:UiText AdaptiveCancel}" Click="OnCancelClick" Style="{StaticResource AdaptiveBarButtonStyle}" ToolTip="{localization:UiText AdaptiveCancelTooltip}" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="1">
            <ContentControl x:Name="contentHost" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="8" Background="#C018212E" BorderBrush="#49627D" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="statusText" Foreground="#F5F8FC" automation:AutomationProperties.Name="{localization:UiText AdaptiveViewerStatusName}" automation:AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="operationProgress" Height="5" Width="180" Margin="0,6,0,0" Visibility="Collapsed" IsIndeterminate="True" />
                </StackPanel>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="8" Background="#C018212E" BorderBrush="#49627D" BorderThickness="1" CornerRadius="8" MaxWidth="360">
                <StackPanel>
                    <TextBlock Text="{localization:UiText AdaptiveDataQualityTitle}" Foreground="#F5F8FC" FontWeight="SemiBold" />
                    <ListBox x:Name="anomalyList" MaxHeight="100" Margin="0,4,0,0" Background="Transparent" BorderThickness="0" Foreground="#F5C26B" SelectionChanged="OnAnomalySelected" />
                    <TextBlock x:Name="segmentationText" Foreground="#A8C7E8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="acceptSegmentationButton" Content="{localization:UiText AdaptiveAccept}" Click="OnAcceptSegmentationClick" Margin="0,0,6,0" Padding="8,3" />
                        <Button x:Name="rejectSegmentationButton" Content="{localization:UiText AdaptiveReject}" Click="OnRejectSegmentationClick" Padding="8,3" />
                        <Button x:Name="retryButton" Content="{localization:UiText AdaptiveRetry}" Click="OnRetryQualityClick" Margin="6,0,0,0" Padding="8,3" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="stateBarText" Padding="8,5" Foreground="#AAB5C3" Background="#111824" automation:AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
