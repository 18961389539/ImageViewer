<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ImageViewer 浅色主题。

        用法（宿主）：
            Application.Current.Resources.MergedDictionaries.Add(new ResourceDictionary
            {
                Source = new Uri("pack://application:,,,/ImageViewerControl;component/Themes/ViewerTheme.Light.xaml")
            });
        控件内部对这些键使用 DynamicResource，因此在窗口运行期间替换也会立即生效。
    -->

    <!-- 背景与表面 -->
    <Color x:Key="ViewerViewportBackgroundColor">#E8EDF4</Color>
    <LinearGradientBrush x:Key="ViewerBackdropBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7F9FC" Offset="0" />
        <GradientStop Color="#EFF3F8" Offset="0.55" />
        <GradientStop Color="#E8EDF4" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ViewerBackdropSolidBrush" Color="#EFF3F8" />
    <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewerSurfaceAltBrush" Color="#F2F5F9" />
    <SolidColorBrush x:Key="ViewerSurfaceOverlayBrush" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="ViewerSurfaceOverlayAltBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ViewerSurfaceInsetBrush" Color="#EDF1F6" />
    <SolidColorBrush x:Key="ViewerMenuPopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewerSurfaceOverlayMenuBrush" Color="#F5FFFFFF" />

    <!-- 描边 -->
    <SolidColorBrush x:Key="ViewerPanelBorderBrush" Color="#C8D3E0" />
    <SolidColorBrush x:Key="ViewerChipBorderBrush" Color="#BCCBDD" />
    <SolidColorBrush x:Key="ViewerMenuBorderBrush" Color="#C8D3E0" />
    <SolidColorBrush x:Key="ViewerPopupBorderBrush" Color="#BCCBDD" />
    <SolidColorBrush x:Key="ViewerInsetBorderBrush" Color="#C1CFDF" />
    <SolidColorBrush x:Key="ViewerOverlayBorderBrush" Color="#9FB4CC" />
    <SolidColorBrush x:Key="ViewerProgressTrackBrush" Color="#E3EAF3" />
    <SolidColorBrush x:Key="ViewerProgressBorderBrush" Color="#C8D3E0" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="ViewerAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ViewerAccentSoftBrush" Color="#202563EB" />
    <SolidColorBrush x:Key="ViewerAccentBorderBrush" Color="#802563EB" />
    <SolidColorBrush x:Key="ViewerSelectionBrush" Color="#2563EB" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="ViewerTextPrimaryBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="ViewerTextSecondaryBrush" Color="#5A6878" />
    <SolidColorBrush x:Key="ViewerTextMutedBrush" Color="#8A97A6" />
    <SolidColorBrush x:Key="ViewerTextDisabledBrush" Color="#A6B1BE" />

    <!-- 交互态 -->
    <SolidColorBrush x:Key="ViewerButtonHoverBrush" Color="#E4EAF3" />
    <SolidColorBrush x:Key="ViewerButtonPressedBrush" Color="#D6DFEC" />
    <SolidColorBrush x:Key="ViewerChipHoverBrush" Color="#DCE5F1" />

    <!-- 网格线与十字线 -->
    <SolidColorBrush x:Key="ViewerGridLineBrush" Color="#B4C4D8" />
    <SolidColorBrush x:Key="ViewerCrosshairBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ViewerSnapGridBrush" Color="#B4C4D8" />

    <!-- 错误态 -->
    <SolidColorBrush x:Key="ViewerErrorBrush" Color="#D64545" />
    <SolidColorBrush x:Key="ViewerErrorSoftBrush" Color="#FCEAEA" />
    <SolidColorBrush x:Key="ViewerErrorBorderBrush" Color="#E0A3A3" />

    <!-- 语义色（提示 / 说明文本） -->
    <SolidColorBrush x:Key="ViewerWarningBrush" Color="#B4761A" />
    <SolidColorBrush x:Key="ViewerInfoBrush" Color="#2C5D8F" />

    <!-- 阴影 -->
    <Color x:Key="ViewerShadowColor">#3A4A5C</Color>
    <sys:Double x:Key="ViewerShadowOpacity">0.16</sys:Double>

    <!-- ROI 属性面板 / 列表 -->
    <SolidColorBrush x:Key="ViewerListItemHoverBrush" Color="#E4EAF3" />
    <SolidColorBrush x:Key="ViewerListItemSelectedBrush" Color="#202563EB" />

</ResourceDictionary>
