<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>true</IsPackable>
    <PackageId>ImageViewerControl</PackageId>
    <Authors>ImageViewer contributors</Authors>
    <Description>Embeddable WPF image viewer with ROI annotation, measurement, analysis, export, and MPR workflows.</Description>
    <PackageTags>wpf;image-viewer;roi;measurement;image-analysis;computer-vision</PackageTags>
    <RepositoryUrl>https://github.com/18961389539/ImageViewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 用 Resource 而不是 EmbeddedResource：WPF 工程会忽略非 XAML 的 EmbeddedResource，
         于是着色器源码根本进不了程序集（DisplayLutShaderCompiler 一直找不到它，GPU 显示调节路径静默失效）。
         Resource 会把它并进 <Assembly>.g.resources，键是小写化的相对路径。 -->
    <Resource Include="Shaders\DisplayLutEffect.ps.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageViewer.Core\ImageViewer.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ImageViewerControl.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
