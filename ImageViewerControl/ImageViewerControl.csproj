<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>true</IsPackable>
    <PackageId>ImageViewerControl</PackageId>
    <Authors>ImageViewer contributors</Authors>
    <Description>Embeddable WPF image viewer with ROI annotation, measurement, analysis, export, and MPR workflows.</Description>
    <PackageTags>wpf;image-viewer;roi;measurement;image-analysis;computer-vision</PackageTags>
    <RepositoryUrl>https://github.com/18961389539/ImageViewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\PseudoColorEffect.ps.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageViewer.Core\ImageViewer.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ImageViewerControl.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
