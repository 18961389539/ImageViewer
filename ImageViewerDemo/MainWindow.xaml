<Window
    x:Class="ImageViewerDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:imageViewer="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
    xmlns:localization="clr-namespace:ImageViewerDemo.Localization"
    Title="{localization:DemoText WindowTitle}"
    Width="1100"
    Height="720"
    Background="#0F172A"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            Background="#111827"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#E2E8F0"
                    FontSize="14"
                    Text="{localization:DemoText ToolbarHint}" />

                <Button
                    Grid.Column="1"
                    Padding="12,6"
                    Click="OnOpenImageClick"
                    Background="#0EA5E9"
                    BorderThickness="0"
                    Content="{localization:DemoText OpenImageButton}"
                    Foreground="White" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Background="#020617"
            BorderBrush="#334155"
            BorderThickness="1"
            CornerRadius="8">
            <imageViewer:AdaptiveImageViewer
                x:Name="Viewer"
                Margin="1"
                Background="#020617" />
        </Border>
    </Grid>
</Window>