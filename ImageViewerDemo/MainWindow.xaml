<Window
    x:Class="ImageViewerDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:imageViewer="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
    xmlns:localization="clr-namespace:ImageViewerDemo.Localization"
    Title="{localization:DemoText WindowTitle}"
    Width="1100"
    Height="720"
    Background="#0A0F16"
    Closing="OnMainWindowClosing"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            Background="#18212E"
            BorderBrush="#314158"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Foreground="#F5F8FC"
                        FontSize="14"
                        Text="{localization:DemoText ToolbarHint}" />
                    <StackPanel x:Name="openProgressPanel" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="openStatusText" Foreground="#AAB5C3" FontSize="12" />
                        <ProgressBar x:Name="openProgressBar" Height="5" Margin="0,4,0,0" Minimum="0" Maximum="100" />
                    </StackPanel>
                    <TextBlock
                        x:Name="openSummaryText"
                        Margin="0,6,0,0"
                        Foreground="#AAB5C3"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        x:Name="openImageButton"
                        Padding="12,6"
                        Click="OnOpenImageClick"
                        Background="#69AFFF"
                        BorderThickness="0"
                        Content="{localization:DemoText OpenImageButton}"
                        Foreground="#11151C" />
                    <Button
                        x:Name="openVolumeButton"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnOpenVolumeClick"
                        Background="#243B57"
                        BorderBrush="#69AFFF"
                        Content="{localization:DemoText OpenVolumeButton}"
                        Foreground="#F5F8FC" />
                    <Button
                        x:Name="cancelOpenButton"
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnCancelOpenClick"
                        Content="{localization:DemoText CancelOpenButton}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Background="#080B11"
            BorderBrush="#314158"
            BorderThickness="1"
            CornerRadius="8">
            <imageViewer:AdaptiveImageViewer
                x:Name="Viewer"
                Margin="1"
                Background="#0A0F16" />
        </Border>
    </Grid>
</Window>
