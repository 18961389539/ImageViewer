<Window
    x:Class="ImageViewerDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:imageViewer="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
    xmlns:localization="clr-namespace:ImageViewerDemo.Localization"
    Title="{localization:DemoText WindowTitle}"
    Width="1100"
    Height="720"
    Background="#0A0F16"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="12"
            Background="#18212E"
            BorderBrush="#314158"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#F5F8FC"
                    FontSize="14"
                    Text="{localization:DemoText ToolbarHint}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Padding="12,6"
                        Click="OnOpenImageClick"
                        Background="#69AFFF"
                        BorderThickness="0"
                        Content="{localization:DemoText OpenImageButton}"
                        Foreground="#11151C" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="12,6"
                        Click="OnOpenVolumeClick"
                        Background="#243B57"
                        BorderBrush="#69AFFF"
                        Content="{localization:DemoText OpenVolumeButton}"
                        Foreground="#F5F8FC" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Background="#080B11"
            BorderBrush="#314158"
            BorderThickness="1"
            CornerRadius="8">
            <imageViewer:AdaptiveImageViewer
                x:Name="Viewer"
                Margin="1"
                Background="#0A0F16" />
        </Border>
    </Grid>
</Window>
