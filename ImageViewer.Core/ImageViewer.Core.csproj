<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>ImageViewer.Core</PackageId>
    <Authors>ImageViewer contributors</Authors>
    <Description>Framework-neutral measurement contracts and statistics for ImageViewer.</Description>
    <PackageTags>image-analysis;measurement;computer-vision;geometry</PackageTags>
    <RepositoryUrl>https://github.com/18961389539/ImageViewer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
